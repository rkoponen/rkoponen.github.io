---
import Layout from "@layouts/Layout.astro";
import RecipeList from "@components/RecipeList.svelte";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recipeList = recipes.map((recipe) => ({
  id: recipe.id,
  title: recipe.data.title,
  description: recipe.data.description,
  totalTime: recipe.data.totalTime,
  servings: recipe.data.servings,
  tags: recipe.data.tags,
}));
---

<Layout title="Reseptit" description="Ruupertin kokkikirja.">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-8 space-y-2">
      <h1
        class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        Reseptit
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-300">
        AI-reseptejä jotka on todettu hyviksi.
      </p>
    </div>

    <RecipeList recipes={recipeList} client:load />
  </main>
</Layout>
