---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="blog">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-8 text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">Posts</h1>

   <ul class="space-y-8">
      {
        posts.map((post) => (
          <li class="group">
            <a href={`/blog/${post.id}`} class="block space-y-1">
              <!-- Date -->
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-500 dark:text-zinc-400">
                {post.data.pubDate.toLocaleDateString(
                  post.data.lang === "fi" ? "fi-FI" : "en-US",
                  {
                    timeZone: "Europe/Helsinki",
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  }
                )}
              </time>
              
              <!-- Post Title -->
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-amber-600 transition-colors">
                {post.data.title}
              </h2>
              
              <!-- Description Snippet -->
              <p class="text-zinc-600 dark:text-zinc-300 line-clamp-2">
                {post.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul> 
  </main>
</Layout>
