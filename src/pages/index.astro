---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Ruupert Koponen" description="Ruupertin kotisivu.">
  <main class="mx-auto max-w-3xl space-y-6 px-4 py-12">
    <section class="space-y-6">
      <div class="flex items-center space-x-4">
        <h1
          class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
        >
          Tervetuloa sivuilleni.
        </h1>
        <img
          src="/images/bear-wave.gif"
          alt="Karhu vilkuttaa"
          class="h-10 w-10 object-contain"
        />
      </div>
    </section>
  </main>
</Layout>
