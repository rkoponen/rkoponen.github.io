---
import { getCollection, render } from "astro:content";
import Prose from "@components/Prose.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
---

<Layout title={recipe.data.title} description={recipe.data.description}>
  <main class="mx-auto max-w-3xl px-4 pt-8 pb-32">
    <article>
      <header class="mb-8">
        <div
          class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400"
        >
          {recipe.data.totalTime && <span>{recipe.data.totalTime}</span>}
          {recipe.data.servings && <span>{recipe.data.servings} annosta</span>}
          {recipe.data.tags.map((tag) => (
            <span class="rounded-full border border-zinc-300 px-2 py-0.5 text-xs dark:border-zinc-700">
              {tag}
            </span>
          ))}
        </div>

        <h1
          class="mb-3 text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
        >
          {recipe.data.title}
        </h1>

        <p class="text-xl leading-relaxed text-zinc-600 italic dark:text-zinc-300">
          {recipe.data.description}
        </p>

        <hr class="mt-6 border-zinc-200 dark:border-zinc-800" />
      </header>

      <Prose>
        <Content />
      </Prose>
    </article>
  </main>
</Layout>
