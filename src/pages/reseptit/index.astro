---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const reseptit = (await getCollection("reseptit")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagit = [...new Set(reseptit.flatMap((resepti) => resepti.data.tagit))].sort(
  (a, b) => a.localeCompare(b, "fi"),
);
---

<Layout title="Reseptit" description="Ruupertin kokkikirja.">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-8 space-y-2">
      <h1
        class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        Reseptit
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-300">
        AI-reseptejä jotka on todettu hyviksi.
      </p>
    </div>

    {
      tagit.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2" data-tagisuodatin>
          <button
            type="button"
            data-tagi=""
            aria-pressed="true"
            class="rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-amber-600 hover:text-amber-600 aria-pressed:border-amber-600 aria-pressed:bg-amber-600 aria-pressed:text-white dark:border-zinc-700 dark:text-zinc-300 dark:aria-pressed:text-white"
          >
            kaikki
          </button>
          {tagit.map((tagi) => (
            <button
              type="button"
              data-tagi={tagi}
              aria-pressed="false"
              class="rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-amber-600 hover:text-amber-600 aria-pressed:border-amber-600 aria-pressed:bg-amber-600 aria-pressed:text-white dark:border-zinc-700 dark:text-zinc-300 dark:aria-pressed:text-white"
            >
              {tagi}
            </button>
          ))}
        </div>
      )
    }

    <ul class="space-y-8" data-reseptilista>
      {
        reseptit.map((resepti) => (
          <li
            class="group"
            data-tagit={resepti.data.tagit.join(" ")}
            hidden={false}
          >
            <a href={`/reseptit/${resepti.id}`} class="block space-y-1">
              <h2 class="text-2xl font-bold text-zinc-900 transition-colors group-hover:text-amber-600 dark:text-zinc-50">
                {resepti.data.title}
              </h2>

              <p class="text-zinc-600 dark:text-zinc-300">
                {resepti.data.description}
              </p>

              <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
                {resepti.data.valmistusaika && (
                  <span>{resepti.data.valmistusaika}</span>
                )}
                {resepti.data.annokset && (
                  <span>{resepti.data.annokset} annosta</span>
                )}
                {resepti.data.tagit.map((tagi) => (
                  <span class="rounded-full border border-zinc-300 px-2 py-0.5 text-xs dark:border-zinc-700">
                    {tagi}
                  </span>
                ))}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <script>
    const suodatin = document.querySelector<HTMLElement>("[data-tagisuodatin]");
    const lista = document.querySelector<HTMLElement>("[data-reseptilista]");

    if (suodatin && lista) {
      const napit = Array.from(
        suodatin.querySelectorAll<HTMLButtonElement>("button[data-tagi]"),
      );
      const reseptit = Array.from(
        lista.querySelectorAll<HTMLElement>("li[data-tagit]"),
      );

      napit.forEach((nappi) => {
        nappi.addEventListener("click", () => {
          const valittu = nappi.dataset.tagi ?? "";

          napit.forEach((toinen) => {
            toinen.setAttribute(
              "aria-pressed",
              String(toinen === nappi),
            );
          });

          reseptit.forEach((resepti) => {
            const tagit = (resepti.dataset.tagit ?? "").split(" ");
            resepti.hidden = valittu !== "" && !tagit.includes(valittu);
          });
        });
      });
    }
  </script>
</Layout>
