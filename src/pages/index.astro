---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout title="Ruupert Koponen" description="Ruupert's homepage.">
  <main class="mx-auto max-w-3xl space-y-6 px-4 py-12">
    <section class="space-y-6">
      <div class="flex items-center space-x-4">
        <h1
          class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
        >
          Welcome, I'm Ruupert.
        </h1>
        <img
          src="/images/bear-wave.gif"
          alt="Karhu vilkuttaa"
          class="h-10 w-10 object-contain"
        />
      </div>

      <p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
        This is my corner of the internet. I'm a software developer based in
        Finland, interested in cycling, 3D printing, thrifting, and many other
        things.
      </p>
    </section>
    <div class="border-t border-zinc-200 dark:border-zinc-800"></div>
    <section class="space-y-4">
      <h2
        class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        Latest writing
      </h2>
      <ul class="space-y-4">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="group block">
                <time class="text-xs text-zinc-500 dark:text-zinc-400">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <h3 class="text-lg font-semibold text-zinc-800 transition-colors group-hover:text-amber-600 dark:text-zinc-100">
                  {post.data.title}
                </h3>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/blog"
        class="inline-block text-sm font-semibold text-amber-600 hover:underline"
      >
        All posts &rarr;
      </a>
    </section>
  </main>
</Layout>
