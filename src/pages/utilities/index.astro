---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Utilities - Ruupert Koponen"
  description="A collection of web-based utilities and tools."
>
  <main class="mx-auto max-w-3xl space-y-8 px-4 py-12">
    <div>
      <h1
        class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        Utilities
      </h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">
        A collection of quick tools.
      </p>
    </div>

    <div class="border-t border-zinc-200 dark:border-zinc-800"></div>

    <ul class="space-y-6">
      <li class="opacity-50 select-none">
        <div class="group block">
          <h2
            class="text-2xl font-bold text-zinc-900 transition-colors group-hover:text-amber-600 dark:text-zinc-50"
          >
            Compound interest (coming soon)
          </h2>
          <p class="mt-1 text-base text-zinc-600 dark:text-zinc-400">
            Check how wealthy you'll be in the future.
          </p>
        </div>
      </li>
    </ul>
  </main>
</Layout>
