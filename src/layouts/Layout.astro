---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fi">
  <head>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Ruupert Koponen",
        "url": "https://ruupert.fi",
        "jobTitle": "Ohjelmistokehittäjä",
        "sameAs": [
          "https://github.com/rkoponen",
          "https://github.com/rkoponen1",
          "https://linkedin.com/in/ruupert"
        ],
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Aalto University",
          "sameAs": "https://www.aalto.fi"
        },
        "knowsAbout": ["Verkkokehitys", "Mobiilikehitys"]
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ruupert Koponen"
      href={new URL("rss.xml", Astro.site)}
    />
  </head>
  <body
    class="bg-stone-50 text-stone-900 transition-colors duration-200 dark:bg-stone-950 dark:text-stone-50"
  >
    <nav class="p-6">
      <div class="mx-auto max-w-3xl px-4">
        <ul class="flex space-x-6 text-sm font-medium">
          <li>
            <a href="/" class="transition-colors hover:text-amber-600"
              >etusivu</a
            >
          </li>
          <li>
            <a href="/kuntosali" class="transition-colors hover:text-amber-600"
              >kuntosali</a
            >
          </li>
          <li>
            <a href="/reseptit" class="transition-colors hover:text-amber-600"
              >reseptit</a
            >
          </li>
        </ul>
      </div>
    </nav>
    <slot />
  </body>
</html>
